    # 2. [수정사항 반영] 증상 목록 Dictionary
    disease_frame = tk.LabelFrame(
        scrollable_frame, text="증상 목록", font=("Malgun Gothic", 16)
    )
    disease_frame.pack(pady=15)
    diseases = {
        "체중 감소": "체중 감소",
        "체중 증가": "체중 증가",
        "관절 통증": "관절 통증",
        "부정맥": "부정맥",
        "인후통": "인후통",
        "근육통": "근육통",
        "치통": "치통",
        "두통": "두통",
        "생리통": "생리통",
        "발열": "발열",
        "두드러기": "두드러기",
        "발진": "발진",
        "재채기": "재채기",
        "콧물(알레르기)": "콧물(알레르기)",
        "울렁거림": "울렁거림",
        "구토": "구토",
        "소화불량": "소화불량",
        "불면증": "불면증",
    }
    for code, name in diseases.items():
        var = tk.IntVar()
        checkbox = tk.Checkbutton(
            disease_frame,
            text=name,
            variable=var,
            font=("Batang", 12),
            command=lambda c=code, v=var: update_selection(
                selected_disease, c, v
            ),
        )
        checkbox.pack(anchor="w")

    # 3. [수정사항 반영] 기타 항목 Dictionary
    etc_frame = tk.LabelFrame(
        scrollable_frame, text="기타 항목", font=("Malgun Gothic", 16)
    )
    etc_frame.pack(pady=15)
    etc = {"없음": "없음", "임신": "임신", "수유 중": "수유 중"}
    for code, name in etc.items():
        var = tk.IntVar()
        checkbox = tk.Checkbutton(
            etc_frame,
            text=name,
            variable=var,
            font=("Batang", 12),
            command=lambda c=code, v=var: update_selection(
                selected_etc, c, v
            ),
        )
        checkbox.pack(anchor="w")

    button = tk.Button(scrollable_frame, text="완료", command=find_medication)
    button.pack(pady=10)


