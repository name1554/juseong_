import json
import os
import tkinter as tk
from tkinter import messagebox

# ------------------------------------------------------------------
# 1. JSON 단일 데이터베이스 로딩
# ------------------------------------------------------------------
BASE_DIR = os.path.dirname(os.path.abspath(__file__))
DB_PATH = os.path.join(BASE_DIR, "medications.json")

try:
    with open(DB_PATH, "r", encoding="utf-8") as f:
        MEDICINE_DB = json.load(f)
except FileNotFoundError:
    MEDICINE_DB = {}
    messagebox.showerror(
        "오류",
        "medications.json 파일을 찾을 수 없습니다.\n같은 폴더에 위치시켜 주세요.",
    )

# 2. 역색인 (Inverted Index) 생성
disease_index = {}  # { "증상명": {약이름, ...} }
age_index = {}  # { "연령대": {약이름, ...} }
etc_index = {}  # { "기타사항": {약이름, ...} }

for med_name, info in MEDICINE_DB.items():
    for disease in info.get("diseases", []):
        disease_index.setdefault(disease, set()).add(med_name)
    for age in info.get("ages", []):
        age_index.setdefault(age, set()).add(med_name)
    for etc in info.get("etc", []):
        etc_index.setdefault(etc, set()).add(med_name)

# 선택된 값을 저장하는 리스트
selected_disease = []
selected_age_group = []
selected_etc = []

# 선택된 약 정보를 저장하는 리스트
selected_medications = []
list_med = []

# 창 상태 추적
selection_window = None
info_window = None
list_window = None
details_windows = {}

# 버튼 생성 여부 확인 변수
med_button_created = False
text_created = False

result_widgets = []
list_result_widgets = []


# [수정사항 반영] 안전하게 수정된 update_selection() 함수
def update_selection(selection_list, option_name, var):
    if var.get():
        if option_name not in selection_list:
            selection_list.append(option_name)
    else:
        if option_name in selection_list:
            selection_list.remove(option_name)


# 개별 약 정보를 표시하는 함수
def show_medication_details(med_name):
    global details_windows
    if med_name in details_windows and tk.Toplevel.winfo_exists(
        details_windows[med_name]
    ):
        details_windows[med_name].lift()
        return

    info = MEDICINE_DB.get(med_name, {})

    details_window = tk.Toplevel(window)
    details_window.title(med_name + " 정보")
    details_window.geometry("500x400")
    details_windows[med_name] = details_window

    details_label = tk.Label(
        details_window,
        text=info.get("desc", "상세 정보가 없습니다."),
        font=("Batang", 12),
        wraplength=450,
    )
    details_label.pack(pady=10)


# 스크롤 프레임 생성 유틸리티 함수
def create_scrollable_frame(parent):
    canvas = tk.Canvas(parent)
    scrollbar = tk.Scrollbar(parent, orient="vertical", command=canvas.yview)
    scrollable_frame = tk.Frame(canvas)

    scrollable_frame.bind(
        "<Configure>",
        lambda e: canvas.configure(scrollregion=canvas.bbox("all")),
    )
    canvas.create_window((0, 0), window=scrollable_frame, anchor="nw")
    canvas.configure(yscrollcommand=scrollbar.set)

    def _on_mouse_wheel(event):
        canvas.yview_scroll(-1 * int(event.delta / 120), "units")

    canvas.bind_all("<MouseWheel>", _on_mouse_wheel)

    canvas.pack(side="left", fill="both", expand=True)
    scrollbar.pack(side="right", fill="y")

    return scrollable_frame


def med_select(med_name, med_label):
    global med_button_created
    global text_created

    if med_name in selected_medications:
        selected_medications.remove(med_name)
        med_label.config(fg="red")
    else:
        selected_medications.append(med_name)
        med_label.config(fg="green")

    if not text_created:
        text_explanation = tk.Label(
            selection_window,
            text="약의 이름이 초록색이면 선택된 것입니다.",
            font=("Batang", 10),
        )
        text_explanation.pack(pady=10)
        text_created = True
        result_widgets.append(text_explanation)

    if not med_button_created:
        finish_button = tk.Button(
            selection_window,
            text="완료",
            font=("Arial", 13),
            command=med_list,
        )
        finish_button.pack(pady=10)
        med_button_created = True
        result_widgets.append(finish_button)


def find_medication():
    global result_widgets
    global med_button_created
    global text_created

    for widget in result_widgets:
        widget.destroy()
    result_widgets.clear()
    med_button_created = False
    text_created = False
    selected_medications.clear()

    if not selected_disease or not selected_age_group or not selected_etc:
        messagebox.showwarning("경고", "모든 항목을 선택하세요.")
        return

    # 증상 조건에 해당하는 약물 집합
    disease_meds = set()
    for d in selected_disease:
        disease_meds.update(disease_index.get(d, set()))

    # 연령 조건에 해당하는 약물 집합
    age_meds = set()
    for a in selected_age_group:
        age_meds.update(age_index.get(a, set()))

    # 기타 조건에 해당하는 약물 집합
    etc_meds = set()
    for e in selected_etc:
        etc_meds.update(etc_index.get(e, set()))

    # 세 조건을 모두 만족하는 약만 교집합(&) 연산으로 필터링
    exact_matches = disease_meds & age_meds & etc_meds

    if not exact_matches:
        result_label = tk.Label(
            selection_window,
            text="해당 조건에 맞는 약을 찾을 수 없습니다.",
            font=("Batang", 12),
            fg="red",
        )
        result_label.pack(side="right", padx=100, pady=2)
        result_widgets.append(result_label)
        return

    for med_name in sorted(exact_matches):
        med_frame = tk.Frame(selection_window)
        med_frame.pack(fill="x", padx=200, pady=5)
        result_widgets.append(med_frame)

        med_label = tk.Label(
            med_frame, text=med_name, font=("Batang", 13), fg="red"
        )
        med_label.pack(side="left", padx=10)
        result_widgets.append(med_label)

        select_button = tk.Button(
            med_frame,
            text="선택",
            command=lambda m=med_name, l=med_label: med_select(m, l),
        )
        select_button.pack(side="right", padx=15)
        result_widgets.append(select_button)

        details_button = tk.Button(
            med_frame,
            text="자세히 보기",
            command=lambda m=med_name: show_medication_details(m),
        )
        details_button.pack(side="right", padx=15)
        result_widgets.append(details_button)


def back_window():
    if list_window and tk.Toplevel.winfo_exists(list_window):
        list_window.destroy()


def destroy_window():
    if list_window and tk.Toplevel.winfo_exists(list_window):
        list_window.destroy()
    if selection_window and tk.Toplevel.winfo_exists(selection_window):
        selection_window.destroy()


def med_list():
    global list_window
    global list_result_widgets
    global list_med

    if list_window and tk.Toplevel.winfo_exists(list_window):
        list_window.lift()
        return

    for widget in list_result_widgets:
        widget.destroy()
    list_result_widgets.clear()
    list_med.clear()

    list_window = tk.Toplevel()
    list_window.title("선택된 약 목록")
    list_window.attributes("-fullscreen", True)

    list_title = tk.Label(
        list_window, text="선택된 약 목록", font=("Malgun Gothic", 23)
    )
    list_title.pack(pady=10, padx=10)
    list_result_widgets.append(list_title)

    line = tk.Label(
        list_window,
        text=(
            "_____________________________________________________________________________________________________________"
            * 2
        ),
    )
    line.pack(pady=10, padx=10)
    list_result_widgets.append(line)

    scrollable_frame2 = create_scrollable_frame(list_window)

    for med_name in selected_medications:
        list_med.append(med_name)

    for med_name in list_med:
        info = MEDICINE_DB.get(med_name, {})

        med_name_label = tk.Label(
            scrollable_frame2, text=med_name, font=("Malgun Gothic", 17)
        )
        med_name_label.pack(padx=555, pady=10, anchor="center")
        list_result_widgets.append(med_name_label)

        med_usage_label = tk.Label(
            scrollable_frame2,
            text=info.get("usage", "복용법 정보 없음"),
            font=("Batang", 15),
        )
        med_usage_label.pack(pady=30, anchor="center")
        list_result_widgets.append(med_usage_label)

    close_button = tk.Button(
        list_window, text="종료", font=("Arial", 16), command=destroy_window
    )
    close_button.pack(pady=10, padx=10, side="right", anchor="se")
    list_result_widgets.append(close_button)

    back_button = tk.Button(
        list_window, text="뒤로 가기", font=("Arial", 16), command=back_window
    )
    back_button.pack(pady=10, padx=10, side="right", anchor="se")
    list_result_widgets.append(back_button)


def open_medication_selection():
    global selection_window
    if selection_window and tk.Toplevel.winfo_exists(selection_window):
        selection_window.lift()
        return

    selection_window = tk.Toplevel(window)
    selection_window.title("질병 선택 프로그램")
    selection_window.attributes("-fullscreen", True)

    scrollable_frame = create_scrollable_frame(selection_window)

    # 1. [수정사항 반영] 연령대 Dictionary
    age_group_frame = tk.LabelFrame(
        scrollable_frame, text="연령대", font=("Malgun Gothic", 16)
    )
    age_group_frame.pack(padx=35, pady=15)
    age_group = {
        "유아": "유아(12세 미만)",
        "성인": "성인(12세 이상~65세 미만)",
        "고령자": "고령자(65세 이상)",
