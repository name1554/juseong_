        result_widgets.append(med_label)

        #선택 버튼 생성
        select_button = tk.Button(med_frame, text="선택", command=lambda m=med,l=med_label: med_select(m,l))
        select_button.pack(side="right",padx=15)
        result_widgets.append(select_button)

        #자세히 보기 버튼 생성
        details_button = tk.Button(med_frame, text="자세히 보기", command=lambda m=med: show_medication_details(m))
        details_button.pack(side="right",padx=15)
        result_widgets.append(details_button)

