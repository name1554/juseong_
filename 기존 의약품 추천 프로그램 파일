def find_medication():
    global result_widgets
    global med_button_created
    global text_created

    # 기존 결과 위젯 제거
    for widget in result_widgets:
        widget.destroy()
    result_widgets.clear()
    med_button_created=False
    text_created=False
    selected_medications.clear()

    # 입력값이 없으면 함수 종료
    if not selected_disease or not selected_age_group or not selected_etc:
        messagebox.showwarning("경고", "모든 항목을 선택하세요.")
        return

    # 결과 초기화
    exact_matches = []

    # 약 데이터 필터링
    for med in medications:
        # 정확히 모든 조건을 만족하는 약
        if (med[0] in selected_age_group and
            med[1] in selected_disease and
            med[2] in selected_etc):
            exact_matches.append(med)

    # 결과 표시
    if not exact_matches:
        result_label = tk.Label(selection_window, text="해당 조건에 맞는 약을 찾을 수 없습니다.", font=("Batang", 12), fg="red")
        result_label.pack(side="right", padx= 100,pady=2)
        result_widgets.append(result_label)
        return

    # 중복 추적을 위한 집합
    seen_medications = set()

    for med in exact_matches:
        # 이미 표시된 약은 건너뜀
        if med[3] in seen_medications:
            continue

        seen_medications.add(med[3])    # 표시된 약 이름 추가

        # 약 프레임 생성
        med_frame = tk.Frame(selection_window)
        med_frame.pack(fill="x", padx=200, pady=5)
        result_widgets.append(med_frame)

        # 약 이름 생성
